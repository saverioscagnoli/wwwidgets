// A caelestia-shell lookalike built from one fullscreen, mostly click-through
// overlay per monitor (frame + bar + drawers), plus four invisible windows that
// reserve the exclusive zones so tiled windows sit inside the frame.
//
// Toggle drawers from keybinds with ./toggle.sh <launcher|dashboard|session>.
{
  notifications: true,
  workspaces: true,
  tray: true,
  audio: true,
  bluetooth: true,
  battery: true,
  network: true,

  widgets: [
    {
      path: "shell.html",
      namespace: "caelestia-drawers",
      anchor: ["top", "right", "bottom", "left"],
      width: "100%",
      height: "100%",
      layer: "top",
      exclusive: -1,
      transparent: true,
    },

    // Exclusion zones. Keep the sizes in sync with --bar and --border in style.css.
    {
      path: "exclusion.html",
      namespace: "caelestia-border-exclusion",
      anchor: "left",
      width: 52,
      height: "100%",
      exclusive: true,
      transparent: true,
      "click-through": true,
      bridge: false,
    },
    {
      path: "exclusion.html",
      namespace: "caelestia-border-exclusion",
      anchor: "top",
      width: "100%",
      height: 10,
      exclusive: true,
      transparent: true,
      "click-through": true,
      bridge: false,
    },
    {
      path: "exclusion.html",
      namespace: "caelestia-border-exclusion",
      anchor: "right",
      width: 10,
      height: "100%",
      exclusive: true,
      transparent: true,
      "click-through": true,
      bridge: false,
    },
    {
      path: "exclusion.html",
      namespace: "caelestia-border-exclusion",
      anchor: "bottom",
      width: "100%",
      height: 10,
      exclusive: true,
      transparent: true,
      "click-through": true,
      bridge: false,
    },
  ],
}
